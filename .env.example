# Django
SECRET_KEY=genere-un-valor-largo-y-aleatorio
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0

# Desarrollo local: omita DATABASE_URL para usar SQLite en DATA_DIR.
DATA_DIR=./data
# DATABASE_PATH=./data/db.sqlite3

# Vercel/Supabase PostgreSQL: use Transaction Pooler (puerto 6543).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_SSL_REQUIRE=1

# En Vercel USE_SUPABASE_STORAGE=1 es obligatorio y el bucket es "eventos".
USE_SUPABASE_STORAGE=0
SUPABASE_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION_NAME=REGION_DEL_PROYECTO
EVENT_IMAGE_URL_TTL=300

# Solo para ejecutar create_initial_admin explícitamente desde un proceso externo.
INITIAL_ADMIN_USERNAME=administrador
INITIAL_ADMIN_PASSWORD=cambie-por-una-clave-de-al-menos-12-caracteres
